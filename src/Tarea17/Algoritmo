1.- META
Programa que despliega un menú interactivo en consola para ejecutar y
demostrar gráficamente el funcionamiento de los tres administradores
de geometría de Tkinter(`pack`, `grid`, `place`),
basándose en ejemplos prácticos de diseño de interfaces.

2.- DATOS
opcionSeleccionada (Entero)

3.- PROCESOS

4.- SALIDA
3.1 desplegarMenu() {
print("--- Administradores de Layout en Tkinter ---");
print("1. Correr ejemplo de layout: Pack");
print("2. Correr ejemplo de layout: Grid");
print("3. Correr ejemplo de layout: Place");
print("4. Salir");
print("Seleccione una opcion: ");
opcionSeleccionada = readInput();
return opcionSeleccionada;
}

4.1 runPackExample() {
framePack = create Frame("Demostracion Pack");

lblRed = create Label("Red Label", bg="red");
lblGreen = create Label("Green Label", bg="green");
lblBlue = create Label("Blue Label", bg="blue");

lblRed.pack(fill="x");
lblGreen.pack(fill="x");
lblBlue.pack(fill="x");

framePack.setSizeX(300);
framePack.setSizeY(200);
framePack.setVisible(true);
}

4.2 runGridExample() {
frameGrid = create Frame("Demostracion Grid");

lblUsername = create Label("Username");
lblPassword = create Label("Password");
txtUsername = create TextField();
txtPassword = create TextField();

lblUsername.grid(row=0, column=0);
txtUsername.grid(row=0, column=1);
lblPassword.grid(row=1, column=0);
txtPassword.grid(row=1, column=1);

frameGrid.setSizeX(300);
frameGrid.setSizeY(150);
frameGrid.setVisible(true);
}

4.3 runPlaceExample() {
