5.- NAVEGACION
main() {
layoutApp = create LayoutManager();
opcionSeleccionada = 0;

while (opcionSeleccionada != 4) {
    opcionSeleccionada = layoutApp.desplegarMenu();

    switch (opcionSeleccionada) {
        case 1:
            layoutApp.runPackExample();
            break;
        case 2:
            layoutApp.runGridExample();
            break;
        case 3:
            layoutApp.runPlaceExample();
            break;
        case 4:
            print("Cerrando el programa...");
            break;
        default:
            print("Opcion no valida, intente de nuevo.");
            break;
    }
}
}
