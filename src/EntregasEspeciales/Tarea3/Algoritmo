OBJETO Frame v
OBJETO List lista
OBJETO ManejaEventosListaSimple oyeLista
OBJETO OnClosedButtonEvent closedButtonEvent

4.- SALIDAS
    4.1 forma()
        INICIO
            v = create Frame()
            set v layout to (create FlowLayout())

            lista = create List(4, false)
            add "lunes" to lista
            add "martes" to lista
            add "miercoles" to lista
            add "jueves" to lista
            add "viernes" to lista
            add "sabado" to lista
            add "domingo" to lista

            add ManejaEventosListaSimple to lista
            add OnClosedButtonEvent to v

            add lista to v
            pack v
            set v visibility to true
        FIN

    4.2 listPrinting(CADENA selectedItem)
        INICIO
            System.out.println(selectedItem)
        FIN

    4.3 exitMessageToPrint()
        INICIO
            System.out.println("Saliendo del programa...")
        FIN

5.- NAVEGACION
    5.1 ManejaEventosListaSimple (IMPLEMENTA ItemListener)
        INICIO
            ON_EVENT (itemStateChanged) DO:
                INICIO
                    IF (event source is lista) THEN
                        INICIO
                            CALL listPrinting(lista.getSelectedItem())
                        FIN
                    END IF
                FIN
            END EVENT
        FIN

    5.2 OnClosedButtonEvent (EXTIENDE WindowAdapter)
        INICIO
            ON_EVENT (windowClosing) DO:
                INICIO
                    CALL exitMessageToPrint()
                    Terminate_Program(0)
                FIN
            END EVENT
        FIN